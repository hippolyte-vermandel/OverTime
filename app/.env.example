# Copier ce fichier en ".env" puis remplacer les valeurs.
# Le fichier .env contient des secrets : il ne doit JAMAIS être envoyé sur GitHub
# (il est déjà exclu par le .gitignore).

# Connexion à PostgreSQL : utilisateur, mot de passe, machine, port, base
DATABASE_URL=postgres://overtime:CHANGE_MOI@localhost:5432/overtime

# Comptes (Better Auth) : clé secrète des sessions et adresse publique de l'application
# Générer une clé : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=REMPLACER_PAR_UNE_LONGUE_CLE_AU_HASARD
BETTER_AUTH_URL=http://localhost:3000

# Fuseau horaire d'affichage des matchs
FUSEAU_HORAIRE=Europe/Paris

# Import automatique des matchs (toutes les heures, et bouton dans l'administration)
# League of Legends : Leaguepedia, sans clé. Régions suivies (niveau « Primary ») :
LEAGUEPEDIA_REGIONS=EMEA,Korea,International
# VALORANT : clé personnelle de l'API Liquipedia. Vide = import VALORANT désactivé.
# Secret : ne jamais la publier sur GitHub.
LPDB_API_KEY=
# Niveaux Liquipedia importés (1 = VCT et grands tournois ; « 1,2 » pour ajouter le niveau 2)
LPDB_TIERS=1
# « non » pour couper l'import automatique horaire
IMPORT_AUTO=oui
# Rocket League et Call of Duty : clé personnelle de l'API PandaScore (offre gratuite).
# Vide = import désactivé. Secret : ne jamais la publier sur GitHub.
PANDASCORE_TOKEN=
